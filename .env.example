# Site origin used to build /sitemap.xml and /rss.xml links.
# Set this in Vercel (Project → Settings → Environment Variables) to your
# deployment URL or custom domain, e.g.:
# NEXT_PUBLIC_SITE_URL=https://knowledge-archive.vercel.app
# Local builds fall back to a placeholder if this is not set.

# Optional. Only required if you move to a database-backed content model.
# The archive currently reads Markdown directly from /content — no DB needed.
# DATABASE_URL=file:./db/archive.db
