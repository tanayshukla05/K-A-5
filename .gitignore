# ROM guard: commercial cartridges must never be committed.
# The archive hosts no commercial ROMs. Exception: public/roms/ carries
# homebrew games released free by their own authors and licensed for
# redistribution - per-game attribution lives in public/roms/CREDITS.md.
*.sfc
*.smc
*.fig
*.srm
*.gba
*.gb
*.gbc
*.nes
*.fds
*.z64
*.v64
!public/roms/*.sfc

# fan-game builds with ripped commercial assets (Mario, Ryu, Shredder,
# Joker, Spider-Man etc.) - never committed, never served. Local play only.
/MultiHero094/
*.exe
